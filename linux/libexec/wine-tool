#!/usr/bin/env python3
# Runs one of Apple's Metal Developer Tools for Windows (metal.exe, metallib.exe, metal-pack.exe, ...) under Wine, as if it were the tool xcrun finds on a Mac.
# Called through a link named after the tool (linux/libexec/metal/metal → this file), by linux/bin/xcrun or directly (dmsh_build.py runs the path `xcrun -f metal` prints).
#   - the platform (which of the per-platform toolsets runs: ios\bin or macos\bin) comes from -isysroot (an iPhoneOS or MacOSX SDK, which the Windows tools do not read and do not get) or from NXN_SDK, which xcrun sets for `xcrun -sdk <sdk> metal`;
#     the metal driver gets it as -target air64-apple-<os><version>, the version from -mios-version-min= / -mmacosx-version-min= (taken out) or the SDK's
#   - absolute paths become Wine's Z: paths (Z: is /), in arguments and in -opt=/path, -I/path, -o/path forms
#   - a command line past Windows' 32 767 characters goes through a response file
#   - standard input, output and the exit code pass through (dmsh_pch.py feeds the source on standard input); Wine's background services are started first, detached,
#     so that they do not hold the caller's output pipe open (nxn.wine_up)
import os, re, subprocess, sys, tempfile
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib')); import nxn

DRIVERS = {'metal'}   # the clang-based compiler driver, which takes -target; the other tools read the platform from their inputs
MIN_FLAG = re.compile(r'^-m(ios|iphoneos|macosx|macos)-version-min=(.+)$')
PATH_PREFIXES = ('-I', '-L', '-F', '-o', '-isystem', '-iquote', '-include-pch', '-include', '-MF', '-MT', '-MQ', '-fmodules-cache-path=', '-frecord-sources-path=')


def winpath(p):
    return 'Z:' + p.replace('/', '\\')


def convert(arg):
    if arg.startswith('/') and not arg.startswith('//'): return winpath(arg)
    if arg.startswith('-'):
        if '=/' in arg:
            k, v = arg.split('=', 1)
            return f'{k}={winpath(v)}'
        for pre in PATH_PREFIXES:
            if arg.startswith(pre + '/') and len(arg) > len(pre) + 1: return pre + winpath(arg[len(pre):])
    if arg.startswith('@/'): return '@' + winpath(arg[1:])
    return arg


def quote_windows(a):   # the quoting CommandLineToArgvW and clang's Windows tokenizer undo
    if a and not re.search(r'[\s"]', a): return a
    out, bs = ['"'], 0
    for c in a:
        if c == '\\': bs += 1; continue
        if c == '"': out.append('\\' * (2 * bs + 1) + '"')
        else: out.append('\\' * bs + c)
        bs = 0
    out.append('\\' * (2 * bs) + '"')
    return ''.join(out)


def main():
    tool = Path(sys.argv[0]).name
    args = sys.argv[1:]
    sdk = os.environ.get('NXN_SDK')
    out, minver, has_target, i = [], None, False, 0
    while i < len(args):
        a = args[i]
        if a == '-isysroot' and i + 1 < len(args):
            sdk = nxn.sdk_of_path(args[i + 1]) or sdk; i += 2; continue
        if a.startswith('-isysroot') and len(a) > 9:
            sdk = nxn.sdk_of_path(a[9:]) or sdk; i += 1; continue
        if a in ('-sdk', '--sdk') and i + 1 < len(args):   # not a Metal tool option; xcrun's, should it get here
            sdk = nxn.sdk_name(args[i + 1]); i += 2; continue
        m = MIN_FLAG.match(a)
        if m and tool in DRIVERS:
            sdk = 'iphoneos' if m[1] in ('ios', 'iphoneos') else 'macosx'; minver = m[2]; i += 1; continue
        if a in ('-target', '--target') or a.startswith('--target=') or a.startswith('-target='): has_target = True
        out.append(a); i += 1
    sdk = sdk or 'macosx'
    if tool in DRIVERS and not has_target and not any(x in ('--version', '-v', '-###', '--help') for x in out):
        try: ver = minver or nxn.sdk_settings(sdk)['version']
        except nxn.Missing as e: nxn.die(str(e))
        out = ['-target', f'air64-apple-{nxn.SDKS[sdk][3]}{ver}'] + out
    try: exe = nxn.metal_tool(tool, sdk)   # the platform's own toolset: Apple's Windows tools must not mix targets and tools
    except nxn.Missing as e: nxn.die(str(e), 127)
    wine = nxn.which('wine64', 'wine')
    if not wine: nxn.die('wine is not installed (the Docker image has it)', 127)
    conv = [convert(a) for a in out]
    nxn.wine_up()   # Wine's services first, attached to nothing: started by this program they would keep its caller's output pipe open (nxn.wine_up)
    env = nxn.wine_env()
    rsp = None
    if sum(len(a) + 3 for a in conv) + len(str(exe)) > 30000:
        fd, rsp = tempfile.mkstemp(prefix='nxn_rsp_', suffix='.rsp', dir=os.environ.get('TMPDIR'))
        with os.fdopen(fd, 'w') as f: f.write(' '.join(quote_windows(a) for a in conv))
        conv = ['@' + winpath(rsp)]
    try:
        r = subprocess.run([wine, str(exe), *conv], env=env)
    finally:
        if rsp: os.unlink(rsp)
    sys.exit(r.returncode)


if __name__ == '__main__':
    main()
