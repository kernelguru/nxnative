#!/usr/bin/env python3
# swiftc for an Apple target: the Linux Swift toolchain's compiler with the player's Xcode SDK and the Swift libraries of Xcode's toolchain as its resource folder.
# The Linux compiler targets Darwin fine; it only lacks Apple's SDK and runtime libraries, which these flags give it. The target is arm64-apple-<os><SDK version> unless -target is given.
import os, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib')); import nxn

args = sys.argv[1:]
try:
    sdk = nxn.sdk_name(os.environ.get('NXN_SDK'))
    s, res = nxn.sdk_settings(sdk), nxn.swift_resource_dir()
    swiftc = nxn.which('swiftc')
    if not swiftc: raise nxn.Missing('swiftc is not installed (the Docker image has the Swift toolchain)')
except nxn.Missing as e: nxn.die(str(e), 72)
pre = []
if '-sdk' not in args: pre += ['-sdk', s['path']]
if '-resource-dir' not in args: pre += ['-resource-dir', str(res)]
if '-target' not in args: pre += ['-target', f'arm64-apple-{nxn.SDKS[sdk][2]}{s["version"]}']
pre += ['-use-ld=lld']
os.execv(swiftc, [swiftc, *pre, *args])
